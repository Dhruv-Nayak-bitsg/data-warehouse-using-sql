/* -----------------------------------------------------------------------------
   Stored Procedure: silver.load_silver
   Description:      Executes the ETL process to populate the Silver layer.
                     Cleanses, standardizes, and moves data from Bronze to Silver.
   Usage:            EXEC silver.load_silver;
   ----------------------------------------------------------------------------- */
CREATE OR ALTER PROCEDURE silver.load_silver 
AS
BEGIN
    -- Declare timing variables for execution logging
    DECLARE @BatchStart DATETIME2 = GETDATE(),
            @BatchEnd DATETIME2,
            @StepStart DATETIME2,
            @StepEnd DATETIME2; 

    BEGIN TRY
        PRINT '******************************************************';
        PRINT '[START] Initiating Silver Layer ETL Process';
        PRINT '******************************************************';

        PRINT '======================================================';
        PRINT ' Phase 1: Processing CRM Data';
        PRINT '======================================================';

        -- --------------------------------------------------
        -- Table: silver.crm_cust_info
        -- --------------------------------------------------
        SET @StepStart = GETDATE();
        PRINT '[INFO] Truncating table: silver.crm_cust_info';
        TRUNCATE TABLE silver.crm_cust_info;

        PRINT '[INFO] Inserting data into: silver.crm_cust_info';
        INSERT INTO silver.crm_cust_info (
            cst_id, cst_key, cst_firstname, cst_lastname, cst_marital_status, cst_gndr, cst_create_date
        )
        SELECT
            cst_id,
            cst_key,
            TRIM(cst_firstname) AS cst_firstname,
            TRIM(cst_lastname)  AS cst_lastname,
            CASE UPPER(TRIM(cst_marital_status))
                WHEN 'S' THEN 'Single'
                WHEN 'M' THEN 'Married'
                ELSE 'n/a'
            END AS cst_marital_status,
            CASE UPPER(TRIM(cst_gndr))
                WHEN 'F' THEN 'Female'
                WHEN 'M' THEN 'Male'
                ELSE 'n/a'
            END AS cst_gndr,
            cst_create_date
        FROM (
            SELECT *,
                   ROW_NUMBER() OVER (PARTITION BY cst_id ORDER BY cst_create_date DESC) AS RowNum
            FROM bronze.crm_cust_info
            WHERE cst_id IS NOT NULL
        ) AS DeduplicatedCustomers
        WHERE RowNum = 1;

        SET @StepEnd = GETDATE();
        PRINT '[SUCCESS] crm_cust_info loaded in ' + CAST(DATEDIFF(SECOND, @StepStart, @StepEnd) AS VARCHAR(10)) + ' sec.';
        PRINT '------------------------------------------------------';

        -- --------------------------------------------------
        -- Table: silver.crm_prd_info
        -- --------------------------------------------------
        SET @StepStart = GETDATE();
        PRINT '[INFO] Truncating table: silver.crm_prd_info';
        TRUNCATE TABLE silver.crm_prd_info;

        PRINT '[INFO] Inserting data into: silver.crm_prd_info';
        INSERT INTO silver.crm_prd_info (
            prd_id, cat_id, prd_key, prd_nm, prd_cost, prd_line, prd_start_dt, prd_end_dt
        )
        SELECT
            prd_id,
            REPLACE(LEFT(prd_key, 5), '-', '_') AS cat_id, 
            SUBSTRING(prd_key, 7, 255)          AS prd_key,        
            prd_nm,
            COALESCE(prd_cost, 0)               AS prd_cost,
            CASE UPPER(TRIM(prd_line))
                WHEN 'M' THEN 'Mountain'
                WHEN 'R' THEN 'Road'
                WHEN 'S' THEN 'Other Sales'
                WHEN 'T' THEN 'Touring'
                ELSE 'n/a'
            END AS prd_line, 
            CAST(prd_start_dt AS DATE) AS prd_start_dt,
            -- Use DATEADD instead of basic subtraction for safer date math
            CAST(DATEADD(DAY, -1, LEAD(prd_start_dt) OVER (PARTITION BY prd_key ORDER BY prd_start_dt)) AS DATE) AS prd_end_dt 
        FROM bronze.crm_prd_info;

        SET @StepEnd = GETDATE();
        PRINT '[SUCCESS] crm_prd_info loaded in ' + CAST(DATEDIFF(SECOND, @StepStart, @StepEnd) AS VARCHAR(10)) + ' sec.';
        PRINT '------------------------------------------------------';

        -- --------------------------------------------------
        -- Table: silver.crm_sales_details
        -- --------------------------------------------------
        SET @StepStart = GETDATE();
        PRINT '[INFO] Truncating table: silver.crm_sales_details';
        TRUNCATE TABLE silver.crm_sales_details;

        PRINT '[INFO] Inserting data into: silver.crm_sales_details';
        INSERT INTO silver.crm_sales_details (
            sls_ord_num, sls_prd_key, sls_cust_id, sls_order_dt, sls_ship_dt, sls_due_dt, sls_sales, sls_quantity, sls_price
        )
        SELECT 
            sls_ord_num,
            sls_prd_key,
            sls_cust_id,
            CASE 
                WHEN sls_order_dt <= 0 OR LEN(CAST(sls_order_dt AS VARCHAR(20))) <> 8 THEN NULL
                ELSE CAST(CAST(sls_order_dt AS VARCHAR(20)) AS DATE)
            END AS sls_order_dt,
            CASE 
                WHEN sls_ship_dt <= 0 OR LEN(CAST(sls_ship_dt AS VARCHAR(20))) <> 8 THEN NULL
                ELSE CAST(CAST(sls_ship_dt AS VARCHAR(20)) AS DATE)
            END AS sls_ship_dt,
            CASE 
                WHEN sls_due_dt <= 0 OR LEN(CAST(sls_due_dt AS VARCHAR(20))) <> 8 THEN NULL
                ELSE CAST(CAST(sls_due_dt AS VARCHAR(20)) AS DATE)
            END AS sls_due_dt,
            -- Sales integrity check
            CASE 
                WHEN sls_sales IS NULL OR sls_sales <= 0 OR sls_sales <> (sls_quantity * ABS(sls_price)) 
                    THEN sls_quantity * ABS(sls_price)
                ELSE sls_sales
            END AS sls_sales, 
            sls_quantity,
            -- Price integrity check
            CASE 
                WHEN sls_price IS NULL OR sls_price <= 0 
                    THEN sls_sales / NULLIF(sls_quantity, 0)
                ELSE sls_price  
            END AS sls_price
        FROM bronze.crm_sales_details;

        SET @StepEnd = GETDATE();
        PRINT '[SUCCESS] crm_sales_details loaded in ' + CAST(DATEDIFF(SECOND, @StepStart, @StepEnd) AS VARCHAR(10)) + ' sec.';
        PRINT '------------------------------------------------------';

        -- --------------------------------------------------
        -- Table: silver.erp_cust_az12
        -- --------------------------------------------------
        SET @StepStart = GETDATE();
        PRINT '[INFO] Truncating table: silver.erp_cust_az12';
        TRUNCATE TABLE silver.erp_cust_az12;

        PRINT '[INFO] Inserting data into: silver.erp_cust_az12';
        INSERT INTO silver.erp_cust_az12 (cid, bdate, gen)
        SELECT
            CASE
                WHEN LEFT(cid, 3) = 'NAS' THEN SUBSTRING(cid, 4, 255)
                ELSE cid
            END AS cid, 
            CASE
                WHEN bdate > GETDATE() THEN NULL
                ELSE bdate
            END AS bdate, 
            CASE UPPER(TRIM(gen))
                WHEN 'F' THEN 'Female'
                WHEN 'FEMALE' THEN 'Female'
                WHEN 'M' THEN 'Male'
                WHEN 'MALE' THEN 'Male'
                ELSE 'n/a'
            END AS gen 
        FROM bronze.erp_cust_az12;

        SET @StepEnd = GETDATE();
        PRINT '[SUCCESS] erp_cust_az12 loaded in ' + CAST(DATEDIFF(SECOND, @StepStart, @StepEnd) AS VARCHAR(10)) + ' sec.';
        PRINT '------------------------------------------------------';

        PRINT '======================================================';
        PRINT ' Phase 2: Processing ERP Data';
        PRINT '======================================================';

        -- --------------------------------------------------
        -- Table: silver.erp_loc_a101
        -- --------------------------------------------------
        SET @StepStart = GETDATE();
        PRINT '[INFO] Truncating table: silver.erp_loc_a101';
        TRUNCATE TABLE silver.erp_loc_a101;

        PRINT '[INFO] Inserting data into: silver.erp_loc_a101';
        INSERT INTO silver.erp_loc_a101 (cid, cntry)
        SELECT
            REPLACE(cid, '-', '') AS cid, 
            CASE TRIM(cntry)
                WHEN 'DE' THEN 'Germany'
                WHEN 'US' THEN 'United States'
                WHEN 'USA' THEN 'United States'
                WHEN '' THEN 'n/a'
                ELSE COALESCE(TRIM(cntry), 'n/a')
            END AS cntry
        FROM bronze.erp_loc_a101;

        SET @StepEnd = GETDATE();
        PRINT '[SUCCESS] erp_loc_a101 loaded in ' + CAST(DATEDIFF(SECOND, @StepStart, @StepEnd) AS VARCHAR(10)) + ' sec.';
        PRINT '------------------------------------------------------';
        
        -- --------------------------------------------------
        -- Table: silver.erp_px_cat_g1v2
        -- --------------------------------------------------
        SET @StepStart = GETDATE();
        PRINT '[INFO] Truncating table: silver.erp_px_cat_g1v2';
        TRUNCATE TABLE silver.erp_px_cat_g1v2;

        PRINT '[INFO] Inserting data into: silver.erp_px_cat_g1v2';
        INSERT INTO silver.erp_px_cat_g1v2 (id, cat, subcat, maintenance)
        SELECT
            id,
            cat,
            subcat,
            maintenance
        FROM bronze.erp_px_cat_g1v2;

        SET @StepEnd = GETDATE();
        PRINT '[SUCCESS] erp_px_cat_g1v2 loaded in ' + CAST(DATEDIFF(SECOND, @StepStart, @StepEnd) AS VARCHAR(10)) + ' sec.';
        PRINT '------------------------------------------------------';

        -- Summary output
        SET @BatchEnd = GETDATE();
        PRINT '******************************************************';
        PRINT '[DONE] Silver Layer ETL Completed Successfully';
        PRINT '       Total Execution Time: ' + CAST(DATEDIFF(SECOND, @BatchStart, @BatchEnd) AS VARCHAR(10)) + ' seconds';
        PRINT '******************************************************';
        
    END TRY
    BEGIN CATCH
        PRINT '!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!';
        PRINT '[ERROR] EXCEPTION ENCOUNTERED IN SILVER LAYER ETL';
        PRINT '!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!';
        PRINT 'Error Number  : ' + CAST(ERROR_NUMBER() AS VARCHAR(20));
        PRINT 'Error State   : ' + CAST(ERROR_STATE() AS VARCHAR(20));
        PRINT 'Error Line    : ' + CAST(ERROR_LINE() AS VARCHAR(20));
        PRINT 'Error Message : ' + ERROR_MESSAGE();
        PRINT '!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!';
    END CATCH
END
